{
  "name": "flagshipeditor",
  "version": "3.0.0",
  "description": "FlagshipEditor — AI Music Video Editor Plugin for After Effects",
  "author": "Issandre & HeliMAn",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist/cep && vite build && node scripts/postbuild.mjs",
    "zxp": "rimraf dist/cep dist/zxp && cross-env ZXP_PACKAGE=true vite build && node scripts/postbuild.mjs",
    "generate:luts": "node scripts/generate-luts.mjs",
    "zip": "npm run build && node scripts/package-windows.mjs",
    "test:ae-bridge": "node scripts/test-ae-bridge.mjs",
    "test:backend-search": "node scripts/test-backend-search.mjs",
    "test:engine-contracts": "node scripts/run-engine-contracts.mjs",
    "test:analysis-jobs": "python3 scripts/test-analysis-jobs.py",
    "test:ui-recovery": "node scripts/test-ui-job-recovery.mjs",
    "test:prores": "python3 scripts/test-prores-fixtures.py",
    "test:windows-package": "node scripts/test-windows-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/node": "^18.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "bolt-cep": "^2.2.3",
    "core-js": "^3.45.0",
    "cross-env": "^7.0.3",
    "fs-extra": "^11.3.0",
    "rimraf": "^6.0.0",
    "rollup": "^4.46.0",
    "rollup-plugin-multi-input": "^1.5.0",
    "rollup-plugin-node-copy": "^1.0.4",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.90.0",
    "types-for-adobe": "^7.2.3",
    "types-for-adobe-extras": "^0.0.9",
    "typescript": "^5.0.0",
    "vite": "^6.3.5",
    "vite-cep-plugin": "^2.2.3"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
