{
  "style_name": "worldwide_films",
  "display_name": "World Wide Films (Trap/Drill)",
  "cut_strategy": {
    "intro": {
      "cut_interval": "2_beat",
      "variation": "build",
      "double_time_on_808": false
    },
    "verse": {
      "cut_interval": "0.5_beat",
      "variation": "aggressive",
      "double_time_on_808": true
    },
    "chorus": {
      "cut_interval": "0.25_beat",
      "variation": "max_aggression",
      "double_time_on_808": true
    },
    "drop": {
      "cut_interval": "0.125_beat",
      "variation": "strobe_cuts",
      "double_time_on_808": true
    },
    "bridge": {
      "cut_interval": "1_beat",
      "variation": "tension",
      "double_time_on_808": false
    },
    "outro": {
      "cut_interval": "2_beat",
      "variation": "fade",
      "double_time_on_808": false
    }
  },
  "zoom_punch": {
    "enabled": true,
    "scale_target": 160,
    "scale_duration_frames": 2,
    "ease_out_frames": 6,
    "sections": ["drop", "chorus"]
  },
  "whip_pan": {
    "enabled": true,
    "displacement_px": 2500,
    "duration_frames": 3,
    "sections": ["verse", "drop"]
  },
  "text_overlays": {
    "enabled": false,
    "sections": []
  },
  "color_grading": {
    "global_lut": "worldwide_dark.cube",
    "params": {
      "temperature_k": 4200,
      "contrast": 30,
      "saturation": -10
    },
    "section_luts": {
      "drop": "worldwide_neon_dark.cube"
    }
  },
  "camera_shake": {
    "frequency_hz": 40,
    "displacement_px": 20,
    "sections": ["drop", "chorus", "verse"]
  },
  "freeze_frame": {
    "enabled": true,
    "duration_frames": 4,
    "sections": ["drop"],
    "trigger": "808"
  },
  "speed_ramp": {
    "enabled": true,
    "speed_in": 300,
    "speed_out": 50,
    "ramp_duration_beats": 1,
    "sections": ["verse", "drop"]
  },
  "light_leaks": {
    "enabled": false
  },
  "vhs_overlay": {
    "enabled": false
  },
  "glitch_effect": {
    "enabled": true,
    "duration_frames": 4,
    "displacement_px": 25,
    "sections": ["drop", "verse", "chorus"],
    "trigger": "808"
  },
  "element_3d": {
    "enabled": false,
    "solid_name": "FlagshipEditor_3D_Solid",
    "parallax_depth": 0.3
  },
  "face_mask": {
    "enabled": false
  },
  "smoke_fog": {
    "enabled": false
  },
  "slow_mo": {
    "enabled": true,
    "speed_factor": 0.2,
    "sections": ["bridge"],
    "trigger": "punchline"
  },
  "beat_flash": {
    "enabled": true,
    "opacity_peak": 80,
    "duration_frames": 1,
    "sections": ["drop"]
  },
  "rgb_split": {
    "enabled": true,
    "displacement_px": 8,
    "sections": ["drop", "chorus"],
    "trigger": "808"
  },
  "strobe": {
    "enabled": true,
    "frequency_hz": 12,
    "opacity_peak": 60,
    "sections": ["drop"]
  },
  "mask_transition": {
    "enabled": true,
    "type": "linear_wipe",
    "duration_frames": 4,
    "sections": ["verse", "chorus"]
  }
}