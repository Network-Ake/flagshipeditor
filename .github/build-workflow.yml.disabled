name: Build FlagshipEditor ZXP/CCX

on:
  push:
    tags:
      - "v*"
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Install dependencies
        run: yarn install --frozen-lockfile

      - name: Build
        run: yarn build

      - name: Package ZXP
        run: yarn zxp

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: flagshipeditor-zxp
          path: dist/*.zxp

      - name: Create Release
        uses: softprops/action-gh-release@v1
        with:
          files: dist/*.zxp
          draft: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}