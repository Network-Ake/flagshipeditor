{
  "style_name": "lyrical_lemonade",
  "display_name": "Lyrical Lemonade (Cole Bennett)",
  "cut_strategy": {
    "intro": {
      "cut_interval": "4_beat",
      "variation": "build",
      "double_time_on_drop": false
    },
    "verse": {
      "cut_interval": "1_beat",
      "variation": "dynamic",
      "double_time_on_drop": false
    },
    "chorus": {
      "cut_interval": "0.5_beat",
      "variation": "high_energy",
      "double_time_on_drop": true
    },
    "drop": {
      "cut_interval": "0.25_beat",
      "variation": "rapid_fire",
      "double_time_on_drop": true
    },
    "bridge": {
      "cut_interval": "2_beat",
      "variation": "slow",
      "double_time_on_drop": false
    },
    "outro": {
      "cut_interval": "4_beat",
      "variation": "fade",
      "double_time_on_drop": false
    }
  },
  "zoom_punch": {
    "enabled": true,
    "scale_target": 150,
    "scale_duration_frames": 4,
    "ease_out_frames": 10,
    "sections": ["chorus", "drop"]
  },
  "whip_pan": {
    "enabled": true,
    "displacement_px": 2000,
    "duration_frames": 5,
    "sections": ["verse", "chorus"]
  },
  "text_overlays": {
    "enabled": true,
    "font": "Arial Black",
    "size": 64,
    "color": "#FFFF00",
    "position": "dynamic",
    "animation": "kinetic",
    "sections": ["chorus", "drop"]
  },
  "color_grading": {
    "global_lut": "lyrical_lemonade_vibrant.cube",
    "params": {
      "temperature_k": 5500,
      "contrast": 15,
      "saturation": 10
    },
    "section_luts": {
      "drop": "lyrical_lemonade_neon.cube",
      "chorus": "lyrical_lemonade_vibrant.cube"
    }
  },
  "camera_shake": {
    "frequency_hz": 25,
    "displacement_px": 12,
    "sections": ["drop", "chorus"]
  },
  "freeze_frame": {
    "enabled": true,
    "duration_frames": 8,
    "sections": ["drop"],
    "trigger": "beat"
  },
  "speed_ramp": {
    "enabled": true,
    "speed_in": 200,
    "speed_out": 50,
    "ramp_duration_beats": 1,
    "sections": ["verse", "bridge"]
  },
  "light_leaks": {
    "enabled": true,
    "opacity": 30,
    "frequency": "random",
    "sections": ["intro", "bridge", "outro"]
  },
  "vhs_overlay": {
    "enabled": true,
    "opacity": 15,
    "scanlines": true,
    "sections": ["intro", "outro"]
  },
  "glitch_effect": {
    "enabled": false,
    "duration_frames": 3,
    "displacement_px": 10,
    "sections": []
  },
  "element_3d": {
    "enabled": false,
    "solid_name": "FlagshipEditor_3D_Solid",
    "parallax_depth": 0.2
  },
  "face_mask": {
    "enabled": false
  },
  "smoke_fog": {
    "enabled": false
  },
  "slow_mo": {
    "enabled": true,
    "speed_factor": 0.4,
    "sections": ["bridge"],
    "trigger": "punchline"
  },
  "beat_flash": {
    "enabled": true,
    "opacity_peak": 60,
    "duration_frames": 3,
    "sections": ["drop", "chorus"]
  },
  "picture_in_picture": {
    "enabled": true,
    "scale": 30,
    "position": "top_right",
    "sections": ["verse"]
  }
}